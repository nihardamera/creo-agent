# Python
__pycache__/
*.py[cod]

# Environment variables (DO NOT COMMIT). .env.example is committed.
.env

# Runtime state: checkpoints, mock-ticket and executor databases
*.db
*.sqlite
*.sqlite-journal

# macOS
.DS_Store

# iCloud syncs ~/Desktop and hides files inside synced folders, so the venv
# and runtime data live in *.nosync folders behind symlinks.
.venv
var
*.nosync/

# Tool caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/

# P4: regenerated by `python -m creo.tune.data` and `python -m creo.tune.teacher sft`
tune/data/*.jsonl
!tune/data/test.jsonl
!tune/data/test_probes.jsonl
tune/models
tune/models.nosync/
tune/pod/
